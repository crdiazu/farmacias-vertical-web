# ==============================================================================
# Farmacias Vertical — Variables de Entorno (Plantilla sin secretos)
# Copiar a .env.local para desarrollo local. Nunca subir secretos al repo.
# ==============================================================================

# --- Base de datos PostgreSQL (Prisma) ---
# Opcional en Fase 1 preview: si falta, usa SeedCatalogRepository en memoria.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farmacias_vertical?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/farmacias_vertical?schema=public"

# --- Sitio y Regulación ISP ---
NEXT_PUBLIC_SITE_NAME="Farmacias Vertical"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# PRE_ISP: bloquea compra online de medicamentos (solo consulta en mesón)
# FULL_ISP: habilita venta online según condición (VD / Receta Simple / Retenida)
STORE_REGULATORY_MODE="PRE_ISP"

# --- Proveedor de Catálogo e Integraciones ---
# Valores: prisma | seed | shopify
CATALOG_PROVIDER="prisma"
# URL de exportación CSV de Google Sheets (solo lectura, opcional para sync)
GOOGLE_SHEETS_CSV_URL=""

# --- Autenticación (Auth.js - Fase 2) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- Cifrado de Datos Sensibles (RUT, direcciones, teléfono) ---
# Llave AES-256 en hex (64 caracteres) y secreto HMAC en hex
PII_ENCRYPTION_KEY=""
PII_HMAC_SECRET=""

# --- Almacenamiento S3-compatible para Recetas Médicas (Fase 3) ---
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="farmacias-vertical-rx-private"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
RX_RETENTION_DAYS="180"

# --- Pasarela de Pagos Chile (Webpay Plus - Fase 3) ---
# Valores: integration | production
WEBPAY_ENV="integration"
WEBPAY_COMMERCE_CODE=""
WEBPAY_API_KEY=""

# --- Atención al Cliente y Analítica Desacoplada ---
NEXT_PUBLIC_WHATSAPP_NUMBER="56900000000"
# Valores: none | crisp | tawk | custom
NEXT_PUBLIC_CHAT_PROVIDER="none"
NEXT_PUBLIC_GTM_ID=""
